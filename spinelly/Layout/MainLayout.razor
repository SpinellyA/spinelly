@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />

<div class="channel @(_isDarkMode ? "theme-dark" : "theme-light")">
    <a class="skip-link" href="#projects">Skip to projects</a>

    @* The station bug: what is on, where it is broadcast from, and what time it is there. *@
    <header class="bug-bar">
        <div class="wrap bug-inner">
            <a href="#home" class="wordmark" aria-label="spinelly, back to top">spinelly<span class="wordmark-dot">.</span></a>

            <nav class="programmes @(_menuOpen ? "programmes--open" : "")" aria-label="Sections">
                @foreach (var (id, label) in Programmes)
                {
                    <a href="#@id" data-programme="@id" @onclick="() => _menuOpen = false">@label</a>
                }
            </nav>

            <div class="bug-status" aria-live="off">
                <span class="bug-now"><span class="bug-now-label">Now</span><span id="bug-now-text"></span></span>
                <span class="bug-clock" title="Local time in Cebu, Philippines">Cebu <time>@_clock</time></span>
            </div>

            <button type="button" class="bug-btn" @onclick="DarkModeToggle"
                    aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                <MudIcon Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Outlined.DarkMode)" Size="Size.Small" />
            </button>
            <button type="button" class="bug-btn bug-menu" @onclick="() => _menuOpen = !_menuOpen"
                    aria-expanded="@(_menuOpen ? "true" : "false")" aria-label="Sections menu">
                <MudIcon Icon="@(_menuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" Size="Size.Small" />
            </button>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="wrap footer-inner">
            <span>&copy; @DateTime.Now.Year spinelly. Built with Blazor WebAssembly &amp; MudBlazor.</span>
            <span class="footer-links">
                <a href="https://github.com/SpinellyA/" target="_blank" rel="noopener">GitHub</a>
                <a href="mailto:cabildo.alexsam@gmail.com">Email</a>
            </span>
        </div>
    </footer>
</div>

@code {
    private static readonly (string Id, string Label)[] Programmes =
    [
        ("projects", "Projects"),
        ("about", "About"),
        ("education", "Education"),
        ("skills", "Skills"),
        ("contact", "Contact"),
    ];

    private bool _menuOpen;
    private bool _isDarkMode = true;
    private string _clock = "";
    private Timer? _clockTimer;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "0px" },
            Typography = new Typography
            {
                Default = new DefaultTypography { FontFamily = ["Archivo", "Helvetica", "Arial", "sans-serif"] }
            }
        };

        UpdateClock();
        _clockTimer = new Timer(_ => InvokeAsync(() => { UpdateClock(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    // The Philippines has no daylight saving, so a fixed UTC+8 is exact.
    private void UpdateClock() => _clock = DateTime.UtcNow.AddHours(8).ToString("HH:mm");

    private void DarkModeToggle() => _isDarkMode = !_isDarkMode;

    public void Dispose() => _clockTimer?.Dispose();

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#5b47d6",
        Secondary = "#0f8f78",
        Background = "#f3f2f8",
        Surface = "#ffffff",
        TextPrimary = "#16141f",
        TextSecondary = "#4f4b63",
        AppbarBackground = "#f3f2f8",
        Divider = "#d3cfe5",
        LinesDefault = "#d3cfe5",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#b3a6ff",
        Secondary = "#9ff2dc",
        Background = "#0f0e16",
        Surface = "#1c1a29",
        TextPrimary = "#eceafc",
        TextSecondary = "#a9a5c4",
        AppbarBackground = "#0f0e16",
        Divider = "#2b2840",
        LinesDefault = "#2b2840",
        Warning = "#ffcf80",
        Error = "#ff4d5e",
    };
}
