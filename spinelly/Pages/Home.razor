@page "/"
@inject IJSRuntime JS

<PageTitle>Sup - am Spinelly</PageTitle>

<section id="home" class="ident">
    <div class="wrap ident-grid">
        @* The presenter shot: a viewfinder with its on-screen display, and the
           ident burned in as one lower third over the picture. *@
        <figure class="viewfinder">
            <div class="vf-screen">
                <img src="images/profile.jpg" alt="Portrait of Alex Sam Cabildo" />
                <span class="monitor-scanlines" aria-hidden="true"></span>
                <span class="vf-corner vf-corner--tl" aria-hidden="true"></span>
                <span class="vf-corner vf-corner--tr" aria-hidden="true"></span>
                <span class="vf-corner vf-corner--bl" aria-hidden="true"></span>
                <span class="vf-corner vf-corner--br" aria-hidden="true"></span>
                <span class="vf-osd vf-osd--tl" aria-hidden="true">CAM 1</span>
                <HeroTimecode />
            </div>
            <figcaption class="ident-strap">
                <span class="ident-call">What's poppin'? You can call me</span>
                <h1 class="ident-name">Alex</h1>
                <span class="ident-full">Alex Sam Cabildo · Full-Stack Developer &amp; 3rd-Year CS Major</span>
            </figcaption>
        </figure>

        <div class="ident-copy">
            <p class="ident-emphasis">Nothing stops me and my vision. It will happen.</p>
            <p class="ident-desc">
                I live in .NET, and systems architecture and design is where I do my best thinking.
                I build software that transforms experiences, brings in people, and boosts productivity. This means software such as my recently founded <strong>Bursaria</strong>,
                a highly complex Scholarship Management System that aims to solve the core problems of today's workflows.
            </p>

            <div class="actions">
                <a class="btn btn-primary" href="#projects">View My Work</a>
                <a class="btn btn-ghost" href="resume">Resume</a>
                <a class="btn btn-ghost" href="#contact">Get In Touch</a>
            </div>

            <p class="ident-note">
                Curious about the person behind the code? Reach out. I don't bite, and I'll gladly go down a
                rabbit hole with you on just about anything.
            </p>
        </div>
    </div>
</section>

<section id="projects" class="section section-band">
    <div class="wrap">
        <header class="strap">
            <h2 class="strap-title"><span>Featured work</span></h2>
            <span class="strap-tag">@_projects.Count tapes · @_projects.Count(p => p.Live) live</span>
        </header>
        <p class="section-lede">
            One good thing about creating something is that it persists through the greed of time.
            That's the soul of my video creation hobby. Here are some of my favorite projects. Please select a tape to play it.
        </p>

        <ProjectShowcase Projects="_projects" />
    </div>
</section>

<section id="about" class="section">
    <div class="wrap">
        <header class="strap">
            <h2 class="strap-title"><span>Software? Coding? No, I aspire to create.</span></h2>
        </header>

        <div class="about-grid">
            <div class="about-text">
                <p>
                    My main passion is creation, not just code. Everyone says it these days: "I love coding," or "I love engineering software", it's the same tired line.
                    But what I actually care about is taking a rough idea and turning it into something people can use.
                    There's something deeply special about watching an idea of mine actually change how people work, and knowing my name is on that outcome.
                </p>
                <p>
                    That's why my projects are built FOR users, not just some pretentious attempt at ambitious innovation. The same drive extends
                    past my code; it's why I make YouTube videos, write, and pick up whatever skill a project actually needs.
                </p>
                <p class="about-question">Tell me, reader. What soul does software have if it doesn't solve people's problems?</p>
            </div>

            <aside class="facts" aria-labelledby="facts-title">
                <h3 id="facts-title" class="facts-title">Quick Facts</h3>
                <dl>
                    <div><dt>Year</dt><dd>3rd-Year CS Major</dd></div>
                    <div><dt>Based in</dt><dd>Cebu, Philippines</dd></div>
                    <div><dt>Stack</dt><dd>.NET Purist (C#)</dd></div>
                    <div><dt>Channel</dt><dd>YouTube Creator (2K+ Subs)</dd></div>
                </dl>
            </aside>
        </div>
    </div>
</section>

<section id="education" class="section section-band">
    <div class="wrap">
        <header class="strap">
            <h2 class="strap-title"><span>Academic background</span></h2>
            <span class="strap-tag">2018 to present</span>
        </header>

        <ol class="schedule">
            @foreach (var entry in _education)
            {
                <li class="slot">
                    <span class="slot-time">@entry.Period</span>
                    <span class="slot-logo">
                        @if (!string.IsNullOrEmpty(entry.LogoUrl))
                        {
                            <img src="@entry.LogoUrl" alt="@entry.Institution logo" />
                        }
                    </span>
                    <div class="slot-body">
                        <h3 class="slot-title">@entry.Title</h3>
                        <p class="slot-school">@entry.Institution</p>
                        @if (!string.IsNullOrEmpty(entry.Description))
                        {
                            <p class="slot-desc">@entry.Description</p>
                        }
                        @if (entry.Highlights.Count > 0)
                        {
                            <ul class="honors" aria-label="Honors">
                                @foreach (var highlight in entry.Highlights)
                                {
                                    <li class="honor">
                                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Small" />
                                        @highlight.Name
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

<section id="skills" class="section">
    <div class="wrap">
        <header class="strap">
            <h2 class="strap-title"><span>What I work with</span></h2>
            <span class="strap-tag">@_skillGroups.Sum(g => g.Items.Count) tools · @_skillGroups.Sum(g => g.Items.Count(i => i.Reluctant)) reluctant</span>
        </header>

        <div class="lineup">
            @foreach (var group in _skillGroups)
            {
                <div class="lineup-row">
                    <h3 class="lineup-name">@group.Category</h3>
                    <ul class="tag-row">
                        @foreach (var skill in group.Items)
                        {
                            var tip = skill.Reluctant ? "Used it. Can still use it. Would rather not." : skill.Description;
                            <li>
                                <MudTooltip Text="@tip" Disabled="@string.IsNullOrEmpty(tip)">
                                    <span class="tag @(skill.Reluctant ? "tag-reluctant" : "") @(string.IsNullOrEmpty(tip) ? "" : "tag-has-tip")"
                                          tabindex="@(string.IsNullOrEmpty(tip) ? null : "0")">
                                        @if (skill.Reluctant)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.SentimentVeryDissatisfied" Size="Size.Small" />
                                        }
                                        @skill.Name
                                    </span>
                                </MudTooltip>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<section id="contact" class="section section-band signoff">
    <div class="wrap">
        <header class="strap">
            <h2 class="strap-title strap-title--xl"><span>Let's build something</span></h2>
            <span class="strap-tag">Internships · Freelance</span>
        </header>
        <p class="section-lede">
            Open to internships, freelance work, and anything worth building together. Pick a channel, say hi.
        </p>
        <div class="actions">
            <a class="btn btn-primary btn-lg" href="mailto:cabildo.alexsam@gmail.com">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" /> Email Me
            </a>
            <a class="btn btn-ghost btn-lg" href="https://github.com/SpinellyA/" target="_blank" rel="noopener">
                <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" /> GitHub
            </a>
            <a class="btn btn-ghost btn-lg" href="resume">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> Resume
            </a>
        </div>
        <p class="signoff-address">cabildo.alexsam@gmail.com</p>
    </div>
</section>

